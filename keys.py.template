def generate_file_token(path: str) -> str:
    # 发放前清掉过期项：访问端只在 token 被再次访问时才惰性删除，
    # 从未被再次访问的过期 token 会常驻内存
    now = time.time()
    for expired in [t for t, info in FILE_TOKENS.items() if info["expires_at"] < now]:
        FILE_TOKENS.pop(expired, None)
    token = secrets.token_urlsafe(32)
    FILE_TOKENS[token] = {
        "path": path,
        "expires_at": now + TOKEN_TTL,
    }
    return token

