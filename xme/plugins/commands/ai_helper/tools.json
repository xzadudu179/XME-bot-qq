    {
        "type": "function",
        "function": {
            "name": "edit_file",
            "description": "用精确文本匹配改写文件：把文件中的 old_string 原样替换为 new_string。old_string 必须与文件内容逐字符一致（含缩进与换行），取自最近一次读取的内容；找不到匹配会提示文件可能已变化需重新读取；匹配到多处时要求加长 old_string 使其唯一，或置 replace_all=true 全部替换。new_string 为空串即删除该段；追加内容请以文件结尾的唯一文本作 old_string 锚点（new_string=锚点+新内容）。单次只描述一处修改，多处不同修改请分多次调用。",
            "parameters": {
                "type": "object",
                "properties": {
                    "ref": {
                        "type": "string",
                        "description": "文件引用（temp 或 history）"
                    },
                    "old_string": {
                        "type": "string",
                        "description": "要被替换的原文，必须与文件内容完全一致（逐字符，含空白）"
                    },
                    "new_string": {
                        "type": "string",
                        "description": "替换后的新文本（多行用 \\n 分隔）；为空串表示删除 old_string 所在段落"
                    },
                    "replace_all": {
                        "type": "boolean",
                        "description": "是否替换所有匹配处（默认 false，只替换第一处且要求唯一）"
                    }
                },
                "required": [
                    "ref",
                    "old_string",
                    "new_string"
                ]
            }
        }
    },
