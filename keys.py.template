def generate_file_token(path: str, ttl: float | None = None) -> str:
    # 发放前清掉过期项：访问端只在 token 被再次访问时才惰性删除，
    # 从未被再次访问的过期 token 会常驻内存
    now = time.time()
    for expired in [t for t, info in FILE_TOKENS.items() if info["expires_at"] < now]:
        FILE_TOKENS.pop(expired, None)
    token = secrets.token_urlsafe(32)
    FILE_TOKENS[token] = {
        "path": path,
        # ttl 缺省用 TOKEN_TTL；视频这类大文件要留给模型服务端更长的拉取时间
        "expires_at": now + (TOKEN_TTL if ttl is None else ttl),
    }
    return token

